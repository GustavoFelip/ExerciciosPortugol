programa
{
    funcao inicio()
    {
        inteiro contador

        escreva("Os 10 primeiros números inteiros maiores que 100 são:\n")

        // O laço começa em 101 e vai até 110 (10 números no total)
        para (contador = 101; contador <= 110; contador++)
        {
            escreva(contador, " ")
        }
        
        escreva("\n")
    }
}